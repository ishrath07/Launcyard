generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  memberships  StoreMember[]
  chatTurns    ChatTurn[]
}

model Store {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  tagline        String             @default("")
  businessType   String
  logoData       String             @default("")
  phone          String             @default("")
  email          String             @default("")
  whatsapp       String             @default("")
  addressLine    String             @default("")
  city           String             @default("")
  state          String             @default("")
  pincode        String             @default("")
  themeId        String             @default("harbor")
  bannerTitle    String             @default("")
  bannerSubtitle String             @default("")
  aboutText      String             @default("")
  footerNote     String             @default("")
  announcement   String             @default("")
  published      Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  members        StoreMember[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  sections       HomepageSection[]
  activities     Activity[]
  chatTurns      ChatTurn[]
}

model StoreMember {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  role      String
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  storeId  String
  name     String
  slug     String
  source   String    @default("preset")
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
}

model Product {
  id              String    @id @default(cuid())
  storeId         String
  categoryId      String?
  name            String
  slug            String
  description     String    @default("")
  pricePaise      Int
  compareAtPaise  Int?
  sku             String    @default("")
  stock           Int       @default(0)
  imageUrl        String    @default("")
  active          Boolean   @default(true)
  discountPercent Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id])
  variants        Variant[]

  @@unique([storeId, slug])
  @@index([storeId])
}

model Variant {
  id         String  @id @default(cuid())
  productId  String
  name       String
  sku        String  @default("")
  pricePaise Int?
  stock      Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  storeId       String
  number        String
  customerName  String
  email         String
  phone         String
  address       String
  status        String      @default("placed")
  subtotalPaise Int
  note          String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  events        OrderEvent[]

  @@unique([storeId, number])
  @@index([storeId, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String?
  variantId  String?
  name       String
  qty        Int
  pricePaise Int
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  channel   String
  message   String
  sentTo    String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model HomepageSection {
  id      String  @id @default(cuid())
  storeId String
  kind    String
  title   String  @default("")
  body    String  @default("")
  enabled Boolean @default(true)
  sort    Int     @default(0)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  storeId   String
  message   String
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model ChatTurn {
  id           String   @id @default(cuid())
  storeId      String
  userId       String
  question     String
  answer       String
  evidenceJson String   @default("[]")
  createdAt    DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}
